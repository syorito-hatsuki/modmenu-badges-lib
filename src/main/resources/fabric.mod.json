{
  "schemaVersion": 1,
  "id": "modmenu-badges-lib",
  "version": "${version}",
  "name": "ModMenu Badges Lib",
  "authors": [
    "Syorito Hatsuki"
  ],
  "contact": {
    "homepage": "https://syorito-hatsuki.dev/"
  },
  "license": "MIT Licence",
  "icon": "assets/modmenu-badges-lib/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.syoritohatsuki.modmenubadgeslib.client.ModMenuBadgesLibClient"
    ]
  },
  "mixins": [
    "modmenubadgeslib.mixins.json"
  ],
  "custom": {
    "modmenu": {
      "badges": [
        "library"
      ],
      "links": {
        "modmenu.discord": "https://discord.gg/pbwnMwnUD6"
      }
    },
    "mcb": [
      {
        "name": "Ducky House",
        "fillColor": -13730510,
        "outlineColor": -11751600
      }
    ]
  },
  "depends": {
    "fabricloader": "*",
    "fabric-api": "*",
    "minecraft": ">=1.21.6",
    "java": "*"
  },
  "recommends": {
    "modmenu": "*"
  }
}
